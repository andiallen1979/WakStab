#!/usr/bin/env bash
set -euo pipefail
base="/etc/portage/package.accept_keywords"; prefix=""; pin_mode=""; kw_preset=""
usage() {
    cat <<USAGE
Usage: $(basename "$0") [OPTIONS] <category/package> [keywords...]
Options:
  -u, --unstable   Set unstable keyword (~amd64)
  -s, --stable     Set stable keyword (amd64)
  -m, --missing    Set missing/live keyword (**)
  -f, --forward    Resolve and pin forward (>=cat/pkg-ver::repo)
  -e, --exact      Resolve and pin exact version (=cat/pkg-ver::repo)
  -t, --temp       Write to a temporary file (prefixed with TMP_)
  -h, --help       Show this help message and exit
USAGE
}
while [[ "${1:-}" == -* ]]; do
    case "$1" in
        -u|--unstable) kw_preset="~amd64"; shift ;;
        -s|--stable)   kw_preset="amd64"; shift ;;
        -m|--missing)  kw_preset="**"; shift ;;
        -f|--forward)  pin_mode="forward"; shift ;;
        -e|--exact)    pin_mode="exact"; shift ;;
        -t|--temp)     prefix="TMP_"; shift ;;
        -h|--help)     usage; exit 0 ;;
        *) echo "Unknown option: $1" >&2; usage >&2; exit 1 ;;
    esac
done
atom="${1:-}"; shift || true; kws="${kw_preset}${kw_preset:+ }$*"
[[ -z "$atom" || "$atom" != */* ]] && { echo "Error: Full category/package atom required." >&2; usage >&2; exit 1; }
resolve_atom() {
    python3 - "$1" "$2" <<'PY'
import re, sys, portage
raw, mode = sys.argv[slice(1, 3)]
clean, _, _ = re.sub(r"^[<>~=]+", "", raw).partition("::")
clean, _, _ = clean.partition(":")
cp = portage.cpv_getkey(clean) or clean
cat, _, pkg = cp.partition("/")
if not mode:
    print(f"{cat}|{pkg}|{cp}")
    sys.exit(0)
vardb, portdb = portage.db[portage.root]["vartree"].dbapi, portage.db[portage.root]["porttree"].dbapi
def sm(db, a):
    try: return db.match(a)
    except portage.exception.InvalidAtom: return []
has_ver = portage.catpkgsplit(clean) is not None
cand = f"={clean}" if has_ver else clean
m_inst = sm(vardb, cand) or sm(vardb, clean)
m_tree = sm(portdb, cand) or sm(portdb, clean)
if m_inst:
    cpv = sorted(m_inst)[-1]
    repo = next(iter(vardb.aux_get(cpv, ["repository"])), "")
elif m_tree:
    cpv = sorted(m_tree)[-1]
    repo = portdb.getRepositoryName(portdb.findname(cpv)) if portdb.findname(cpv) else ""
else:
    sys.exit(f"Error: Could not resolve '{raw}' in installed or Portage tree.")
op = ">=" if mode == "forward" else "="
suffix = f"::{repo}" if repo else ""
print(f"{cat}|{pkg}|{op}{cpv}{suffix}")
PY
}
IFS='|' read -r dir file target_atom < <(resolve_atom "$atom" "$pin_mode")

[[ -e "$base" && ! -d "$base" ]] && rm -f "$base"
[[ -e "$base/$dir" && ! -d "$base/$dir" ]] && rm -f "$base/$dir"
mkdir -p "$base/$dir"
target_file="$base/$dir/${prefix}${file}"
[[ -d "$target_file" ]] && rm -rf "$target_file"

awk -v ta="$target_atom" -v nk="$kws" 'BEGIN {
    n = split(nk, a, /[[:space:]]+/); c = 0
    for (j = 1; j <= n; j++) {
        if (a[j] == "") continue
        exists = 0
        for (k = 1; k <= c; k++) if (items[k] == a[j]) exists = 1
        if (!exists) items[++c] = a[j]
    }
    line = ta
    for (k = 1; k <= c; k++) line = line " " items[k]
    print line
}' > "$target_file"

echo "Updated ${target_file}: $(cat "$target_file")"
