#!/usr/bin/env bash
set -euo pipefail
base="/etc/portage/package.env"; prefix=""; pin_mode=""
usage() {
    cat <<USAGE
Usage: $(basename "$0") [OPTIONS] <category/package> <env-profile...>
Options:
  -f, --forward    Resolve and pin forward (>=cat/pkg-ver::repo)
  -e, --exact      Resolve and pin exact version (=cat/pkg-ver::repo)
  -t, --temp       Write to a temporary file (prefixed with TMP_)
  -h, --help       Show this help message and exit
USAGE
}
while [[ "${1:-}" == -* ]]; do
    case "$1" in
        -f|--forward) pin_mode="forward"; shift ;;
        -e|--exact)   pin_mode="exact"; shift ;;
        -t|--temp)    prefix="TMP_"; shift ;;
        -h|--help)    usage; exit 0 ;;
        *) echo "Unknown option: $1" >&2; usage >&2; exit 1 ;;
    esac
done
atom="${1:-}"; shift || true; envs="$*"
[[ -z "$atom" || "$atom" != */* || -z "$envs" ]] && { echo "Error: Full category/package atom and env profile(s) required." >&2; usage >&2; exit 1; }
IFS='|' read -r dir file target_atom < <(python3 - "$atom" "$pin_mode" <<'PY'
import re, sys, portage
raw, mode = sys.argv[slice(1, 3)]
clean, _, _ = re.sub(r"^[<>~=]+", "", raw).partition("::")
clean, _, _ = clean.partition(":")
cp = portage.cpv_getkey(clean) or clean
cat, _, pkg = cp.partition("/")
if not mode:
    print(f"{cat}|{pkg}|{cp}"); sys.exit(0)
vardb, portdb = portage.db[portage.root]["vartree"].dbapi, portage.db[portage.root]["porttree"].dbapi
def sm(db, a):
    try: return db.match(a)
    except portage.exception.InvalidAtom: return []
cand = f"={clean}" if portage.catpkgsplit(clean) else clean
mi, mt = sm(vardb, cand) or sm(vardb, clean), sm(portdb, cand) or sm(portdb, clean)
if mi: cpv = sorted(mi)[-1]; repo = next(iter(vardb.aux_get(cpv, ["repository"])), "")
elif mt: cpv = sorted(mt)[-1]; repo = portdb.getRepositoryName(portdb.findname(cpv)) if portdb.findname(cpv) else ""
else: sys.exit(f"Error: Could not resolve '{raw}'.")
print(f"{cat}|{pkg}|{'>=' if mode == 'forward' else '='}{cpv}{f'::{repo}' if repo else ''}")
PY
)
[[ -e "$base" && ! -d "$base" ]] && rm -f "$base"; [[ -e "$base/$dir" && ! -d "$base/$dir" ]] && rm -f "$base/$dir"
mkdir -p "$base/$dir"; target_file="$base/$dir/${prefix}${file}"; [[ -d "$target_file" ]] && rm -rf "$target_file"
awk -v ta="$target_atom" -v ne="$envs" 'BEGIN { n=split(ne,a,/[[:space:]]+/); c=0; for(j=1;j<=n;j++){ if(a[j]=="")continue; ex=0; for(k=1;k<=c;k++) if(it[k]==a[j]) ex=1; if(!ex) it[++c]=a[j] } l=ta; for(k=1;k<=c;k++) l=l" "it[k]; print l }' > "$target_file"
echo "Updated ${target_file}: $(cat "$target_file")"
