#!/usr/bin/env bash
set -euo pipefail
base="/etc/portage/package.env"; env_dir="/etc/portage/env"; prefix=""; pin_mode=""; interactive=0
usage() {
    cat <<USAGE
Usage: $(basename "$0") [-i] [-f|-e] [-t] <category/package> [env-profile...]
Options:
  -i, --interactive  Toggle /etc/portage/env profiles via select/case (default when no profiles given)
  -f, --forward      Resolve and pin forward (>=cat/pkg-ver::repo)
  -e, --exact        Resolve and pin exact version (=cat/pkg-ver::repo)
  -t, --temp         Write to a temporary file (prefixed with TMP_)
  -h, --help         Show this help message and exit
USAGE
}
while [[ "${1:-}" == -* ]]; do
    case "$1" in
        -i|--interactive) interactive=1; shift ;;
        -f|--forward)     pin_mode="forward"; shift ;;
        -e|--exact)       pin_mode="exact"; shift ;;
        -t|--temp)        prefix="TMP_"; shift ;;
        -h|--help)        usage; exit 0 ;;
        *) echo "Unknown option: $1" >&2; usage >&2; exit 1 ;;
    esac
done
atom="${1:-}"; shift || true; envs="$*"
[[ -z "$atom" || "$atom" != */* ]] && { echo "Error: Full category/package atom required." >&2; usage >&2; exit 1; }
[[ -z "$envs" ]] && interactive=1
IFS='|' read -r dir file target_atom < <(python3 - "$atom" "$pin_mode" <<'PY'
import re, sys, portage
raw, mode = sys.argv[slice(1, 3)]
clean, _, _ = re.sub(r"^[<>~=]+", "", raw).partition("::")
clean, _, _ = clean.partition(":")
cp = portage.cpv_getkey(clean) or clean
cat, _, pkg = cp.partition("/")
if not mode:
    print(f"{cat}|{pkg}|{cp}"); sys.exit(0)
vardb, portdb = portage.db[portage.root]["vartree"].dbapi, portage.db[portage.root]["porttree"].dbapi
def sm(db, a):
    try: return db.match(a)
    except portage.exception.InvalidAtom: return []
cand = f"={clean}" if portage.catpkgsplit(clean) else clean
mi, mt = sm(vardb, cand) or sm(vardb, clean), sm(portdb, cand) or sm(portdb, clean)
if mi: cpv = sorted(mi)[-1]; repo = next(iter(vardb.aux_get(cpv, ["repository"])), "")
elif mt: cpv = sorted(mt)[-1]; repo = portdb.getRepositoryName(portdb.findname(cpv)) if portdb.findname(cpv) else ""
else: sys.exit(f"Error: Could not resolve '{raw}'.")
print(f"{cat}|{pkg}|{'>=' if mode == 'forward' else '='}{cpv}{f'::{repo}' if repo else ''}")
PY
)
[[ -e "$base" && ! -d "$base" ]] && rm -f "$base"; [[ -e "$base/$dir" && ! -d "$base/$dir" ]] && rm -f "$base/$dir"
mkdir -p "$base/$dir"; target_file="$base/$dir/${prefix}${file}"; [[ -d "$target_file" ]] && rm -rf "$target_file"

write_env_file() {
    local ta="$1" tf="$2" ne="$3"
    if [[ -z "$ne" ]]; then
        rm -f "$tf"; rmdir "$(dirname "$tf")" 2>/dev/null || true
        echo "Removed ${tf} (no env profiles assigned)."
        return
    fi
    awk -v ta="$ta" -v ne="$ne" 'BEGIN { n=split(ne,a,/[[:space:]]+/); c=0; for(j=1;j<=n;j++){ if(a[j]=="")continue; val=a[j]; if(val !~ /\.conf$/) val=val".conf"; ex=0; for(k=1;k<=c;k++) if(it[k]==val) ex=1; if(!ex) it[++c]=val } l=ta; for(k=1;k<=c;k++) l=l" "it[k]; print l }' > "$tf"
    echo "Updated ${tf}: $(cat "$tf")"
}

if [[ "$interactive" -eq 1 ]]; then
    [[ ! -d "$env_dir" ]] && { echo "Error: ${env_dir} does not exist." >&2; exit 1; }
    mapfile -t avail_envs < <(find "$env_dir" -maxdepth 1 -type f -name '*.conf' ! -name '.*' -printf '%f\n' | sort)
    (( ${#avail_envs[@]} == 0 )) && { echo "No environment files found in ${env_dir}." >&2; exit 1; }
    declare -A active_map=()
    if [[ -f "$target_file" ]]; then
        read -r _ existing_tokens < "$target_file" || true
        for tok in ${existing_tokens:-}; do active_map["$tok"]=1; done
    fi
    declare -a state_arr=()
    for idx in "${!avail_envs[@]}"; do state_arr+=("${active_map[${avail_envs[$idx]}]:-0}"); done
    while true; do
        echo -e "\n=== ${target_atom} (${env_dir}) ==="
        PS3="Toggle env # ([s]ave, [c]lear all, [q]uit): "
        menu_items=(); for idx in "${!avail_envs[@]}"; do menu_items+=("$( [[ "${state_arr[$idx]}" -eq 1 ]] && echo "[+]" || echo "[-]" ) ${avail_envs[$idx]}"); done
        select _ in "${menu_items[@]}"; do
            case "$REPLY" in
                s|S|save)
                    chosen=(); for idx in "${!avail_envs[@]}"; do [[ "${state_arr[$idx]}" -eq 1 ]] && chosen+=("${avail_envs[$idx]}"); done
                    write_env_file "$target_atom" "$target_file" "${chosen[*]:-}"; exit 0 ;;
                c|C|clear)
                    for idx in "${!avail_envs[@]}"; do state_arr[$idx]=0; done; break ;;
                q|Q|quit) echo "Exited without saving."; exit 0 ;;
                *)
                    if [[ "$REPLY" =~ ^[0-9]+$ ]] && (( REPLY >= 1 && REPLY <= ${#avail_envs[@]} )); then
                        ai=$((REPLY - 1)); state_arr[$ai]=$(( 1 - state_arr[$ai] )); break
                    fi; echo "Invalid selection: $REPLY" ;;
            esac
        done
    done
fi
write_env_file "$target_atom" "$target_file" "$envs"
