#!/bin/bash
set -euo pipefail
trap 'echo "ERROR on line ${LINENO}: command \"${BASH_COMMAND}\" exited with status $?" >&2' ERR

NBD_DIR="/var/lib/nbd"
REPOS_SRC="/var/db/repos"
DISTDIR_SRC="/var/cache/distfiles"
PORTAGE_CFG_SRC="/etc/portage"
HOST_MAKE_CONF="${PORTAGE_CFG_SRC}/make.conf"
GENTOO_HOST="distfiles.gentoo.org"
GENTOO_AUTOBUILDS_URL="https://${GENTOO_HOST}/releases/amd64/autobuilds"
IMG_SIZE="64G"
NBD_DEV="/dev/nbd0"
GUEST_ROOT_DEV="/dev/nbd0"
HOST_MNT=""
AUTO_MNT=0
CUSTOM_FSTAB=()
BUILD_MODE="binpkg"
STAGE3_TARBALL=""
STAGE3_VARIANT=""
CUSTOM_MAKE_CONF=""
CONFIG_ROOT_DIR=""
TARGET_HOSTNAME=""
CLEANUP_NEEDED=0

# Parse COMMON_NAME, VVV, PKGDIR, and DISTDIR from local make.conf for binhost/distfiles paths
if [[ -f "$HOST_MAKE_CONF" ]]; then
    COMMON_NAME="$(grep -E '^[[:space:]]*COMMON_NAME=' "$HOST_MAKE_CONF" | tail -n1 | cut -d'=' -f2- | tr -d "\"'")" || true
    VVV="$(grep -E '^[[:space:]]*VVV=' "$HOST_MAKE_CONF" | tail -n1 | cut -d'=' -f2- | tr -d "\"'")" || true
    RAW_PKGDIR="$(grep -E '^[[:space:]]*PKGDIR=' "$HOST_MAKE_CONF" | tail -n1 | cut -d'=' -f2- | tr -d "\"'")" || true
    RAW_DISTDIR="$(grep -E '^[[:space:]]*DISTDIR=' "$HOST_MAKE_CONF" | tail -n1 | cut -d'=' -f2- | tr -d "\"'")" || true
fi

COMMON_NAME="${COMMON_NAME:-$(hostname -s)}"
VVV="${VVV:-1.0.0}"

if [[ -n "${RAW_PKGDIR:-}" ]]; then
    PKGDIR_SRC="${RAW_PKGDIR//\$\{COMMON_NAME\}/$COMMON_NAME}"
    PKGDIR_SRC="${PKGDIR_SRC//\$COMMON_NAME/$COMMON_NAME}"
    PKGDIR_SRC="${PKGDIR_SRC//\$\{VVV\}/$VVV}"
    PKGDIR_SRC="${PKGDIR_SRC//\$VVV/$VVV}"
else
    PKGDIR_SRC="/var/cache/binpkgs/${COMMON_NAME}/${VVV}"
fi

[[ -n "${RAW_DISTDIR:-}" ]] && DISTDIR_SRC="$RAW_DISTDIR"

usage() {
    cat <<EOF
$(basename "$0") - Gentoo qcow2 NBD Root Image Builder (${COMMON_NAME} v${VVV})

USAGE:
  $(basename "$0") [OPTIONS] <target_hostname>

DESCRIPTION:
  Creates a metadata-preallocated qcow2 image, formats it as ext4, extracts a
  Gentoo Stage 3 archive, optionally applies a config_root overlay directory,
  bootstraps @world quietly using the Stage 3's default make.conf, and then
  optionally installs a custom make.conf before finalizing systemd and fstab.

OPTIONS:
  -h, --help        Display this help message and exit
  -l                Fetch and list all live Gentoo amd64 Stage 3 variants and exit
  -v <variant>      Stage 3 variant name or list number (e.g., amd64-nomultilib-systemd or 6)
  -S <tarball>      Use a local Stage 3 tarball instead of downloading from gentoo.org
  -C <make.conf>    Optional final make.conf installed after Stage 3 bootstrap completes
  -c <config_root>  Optional root overlay directory (e.g., containing etc/portage/make.conf,
                    etc/portage/package.use, var/lib/portage/world) layered onto Stage 3
  -b                Build from source instead of using binpkgs (disables --usepkgonly)
  -s <size>         Virtual qcow2 disk size (default: ${IMG_SIZE})
  -d <dir>          Output directory for qcow2 image (default: ${NBD_DIR})
  -n <dev>          Host NBD device used during assembly (default: ${NBD_DEV})
  -r <guest_dev>    Guest root device written to /etc/fstab (default: ${GUEST_ROOT_DEV})
  -m <mnt_dir>      Host staging mount point (default: auto /tmp/mknbd_<host>.XXXXXX)
  -f <fstab_line>   Extra /etc/fstab line for the guest image (repeatable)
  -p <pkgdir>       Override host PKGDIR binhost path (detected: ${PKGDIR_SRC})

NOTES:
  * Must be run as root (requires modprobe nbd, qemu-nbd, mkfs.ext4, mount, chroot).
  * If neither -C nor -c is passed, builds a clean stock Stage 3 system by default.
  * If -c <config_root> contains etc/portage/make.conf, it is held back during bootstrap
    and automatically installed at the end unless overridden by -C.
  * Automatically unmounts and disconnects NBD devices on exit or error.

EXAMPLES:
  1. Pure stock Stage 3 build for custom hand configuration:
     $(basename "$0") -v amd64-nomultilib-systemd -b -s 64G -n /dev/nbd3 Nardz

  2. Overlay directory containing its own etc/portage/make.conf:
     $(basename "$0") -c /root/overlays/nardz -v amd64-nomultilib-systemd -b Nardz

  3. Stock Stage 3 bootstrap + explicit final make.conf:
     $(basename "$0") -C /etc/portage/make.conf -v amd64-desktop-systemd -d /mnt/nbd_store node01
EOF
    exit "${1:-0}"
}

LIVE_RELEASES=()
fetch_live_stage3_index() {
    local master_url="${GENTOO_AUTOBUILDS_URL}/latest-stage3.txt"
    mapfile -t LIVE_RELEASES < <(
        curl -fsSL "$master_url" | grep -E '\.tar\.(xz|zst|bz2|gz)' | awk '{print $1}'
    )
    if [[ ${#LIVE_RELEASES[@]} -eq 0 ]]; then
        echo "Error: Failed to fetch live Stage 3 index from ${master_url}" >&2
        exit 1
    fi
}

list_variants() {
    fetch_live_stage3_index
    local idx=1
    for rel in "${LIVE_RELEASES[@]}"; do
        local fname variant
        fname="$(basename "$rel")"
        variant="$(echo "$fname" | sed -E 's/^stage3-//; s/-[0-9]{8}T[0-9]{6}Z\.tar\..*$//')"
        printf "  %2d) %-32s (%s)\n" "$idx" "$variant" "$fname"
        idx=$((idx + 1))
    done
}

select_and_download_stage3() {
    local chosen_variant="$1"
    fetch_live_stage3_index

    local matched_rel=""
    if [[ -z "$chosen_variant" ]]; then
        list_variants
        read -rp "Select Stage 3 variant [1-${#LIVE_RELEASES[@]}] (default: 1): " choice
        choice="${choice:-1}"
        if ! [[ "$choice" =~ ^[0-9]+$ ]] || [[ "$choice" -lt 1 || "$choice" -gt "${#LIVE_RELEASES[@]}" ]]; then
            echo "Error: Invalid selection '$choice'." >&2
            exit 1
        fi
        matched_rel="${LIVE_RELEASES[$((choice - 1))]}"
    elif [[ "$chosen_variant" =~ ^[0-9]+$ ]]; then
        if [[ "$chosen_variant" -lt 1 || "$chosen_variant" -gt "${#LIVE_RELEASES[@]}" ]]; then
            echo "Error: Invalid variant number '$chosen_variant' (1-${#LIVE_RELEASES[@]})." >&2
            exit 1
        fi
        matched_rel="${LIVE_RELEASES[$((chosen_variant - 1))]}"
    else
        for rel in "${LIVE_RELEASES[@]}"; do
            local fname variant
            fname="$(basename "$rel")"
            variant="$(echo "$fname" | sed -E 's/^stage3-//; s/-[0-9]{8}T[0-9]{6}Z\.tar\..*$//')"
            if [[ "$variant" == "$chosen_variant" ]]; then
                matched_rel="$rel"
                break
            fi
        done
        if [[ -z "$matched_rel" ]]; then
            echo "Error: Variant '${chosen_variant}' not found. Run '$(basename "$0") -l' to list variants." >&2
            exit 1
        fi
    fi

    local tarball_name download_url dest_tarball
    tarball_name="$(basename "$matched_rel")"
    download_url="${GENTOO_AUTOBUILDS_URL}/${matched_rel}"
    dest_tarball="${DISTDIR_SRC}/${tarball_name}"
    mkdir -p "$DISTDIR_SRC"

    if [[ -f "$dest_tarball" ]]; then
        echo "==> Cached Stage 3 found: ${dest_tarball}"
    else
        echo "==> Downloading ${tarball_name}..."
        curl -fL --progress-bar "$download_url" -o "${dest_tarball}.part"
        curl -fsSL "${download_url}.sha256" -o "${dest_tarball}.sha256"

        local expected_sha actual_sha
        expected_sha="$(grep -E '\.tar\.' "${dest_tarball}.sha256" | awk '{print $1}' | head -n1)"
        actual_sha="$(sha256sum "${dest_tarball}.part" | awk '{print $1}')"
        if [[ -z "$expected_sha" || "$expected_sha" != "$actual_sha" ]]; then
            rm -f "${dest_tarball}.part" "${dest_tarball}.sha256"
            echo "Error: SHA-256 mismatch for ${tarball_name}!" >&2
            exit 1
        fi
        mv "${dest_tarball}.part" "$dest_tarball"
        echo "==> Verified and saved to ${dest_tarball}"
    fi
    STAGE3_TARBALL="$dest_tarball"
}

run_in_chroot() {
    local root_dir="$1"
    shift
    mount --types proc /proc "${root_dir}/proc"
    mount --rbind /sys "${root_dir}/sys"
    mount --make-rslave "${root_dir}/sys"
    mount --rbind /dev "${root_dir}/dev"
    mount --make-rslave "${root_dir}/dev"
    mount --bind /run "${root_dir}/run"
    mount --make-slave "${root_dir}/run"

    chroot "$root_dir" /bin/bash -e -c "$*"

    umount -R "${root_dir}/proc" "${root_dir}/sys" "${root_dir}/dev" "${root_dir}/run" 2>/dev/null || true
}

for arg in "$@"; do
    [[ "$arg" == "--help" ]] && usage 0
done

while getopts "lv:S:C:c:bs:d:n:r:m:f:p:h" opt; do
    case "$opt" in
        l) list_variants; exit 0 ;;
        v) STAGE3_VARIANT="$OPTARG" ;;
        S) STAGE3_TARBALL="$OPTARG" ;;
        C) CUSTOM_MAKE_CONF="$OPTARG" ;;
        c) CONFIG_ROOT_DIR="$OPTARG" ;;
        b) BUILD_MODE="source" ;;
        s) IMG_SIZE="$OPTARG" ;;
        d) NBD_DIR="$OPTARG" ;;
        n) NBD_DEV="$OPTARG" ;;
        r) GUEST_ROOT_DEV="$OPTARG" ;;
        m) HOST_MNT="$OPTARG" ;;
        f) CUSTOM_FSTAB+=("$OPTARG") ;;
        p) PKGDIR_SRC="$OPTARG" ;;
        h) usage 0 ;;
        *) usage 1 ;;
    esac
done
shift $((OPTIND - 1))

TARGET_HOSTNAME="${1:-}"
[[ -z "$TARGET_HOSTNAME" ]] && usage 1

if [[ -n "$CONFIG_ROOT_DIR" && ! -d "$CONFIG_ROOT_DIR" ]]; then
    echo "Error: Specified config_root directory '${CONFIG_ROOT_DIR}' not found." >&2
    exit 1
fi

if [[ -z "$CUSTOM_MAKE_CONF" && -n "$CONFIG_ROOT_DIR" && -f "${CONFIG_ROOT_DIR}/etc/portage/make.conf" ]]; then
    CUSTOM_MAKE_CONF="${CONFIG_ROOT_DIR}/etc/portage/make.conf"
fi

if [[ -n "$CUSTOM_MAKE_CONF" && ! -f "$CUSTOM_MAKE_CONF" ]]; then
    echo "Error: Specified make.conf '${CUSTOM_MAKE_CONF}' not found." >&2
    exit 1
fi

[[ $EUID -ne 0 ]] && { echo "Error: Must run as root." >&2; exit 1; }

for cmd in curl sha256sum qemu-img qemu-nbd mkfs.ext4 chroot emerge rsync mountpoint tar; do
    command -v "$cmd" &>/dev/null || { echo "Error: Required command '$cmd' not found." >&2; exit 1; }
done

if [[ "$BUILD_MODE" == "binpkg" && ! -d "$PKGDIR_SRC" ]]; then
    echo "Error: PKGDIR '${PKGDIR_SRC}' not found." >&2
    exit 1
fi

mkdir -p "$NBD_DIR"
IMG_PATH="${NBD_DIR}/${TARGET_HOSTNAME}.qcow2"

[[ -e "$IMG_PATH" ]] && { echo "Error: '${IMG_PATH}' already exists." >&2; exit 1; }
if [[ -z "$STAGE3_TARBALL" ]]; then
select_and_download_stage3 "$STAGE3_VARIANT"
elif [[ ! -f "$STAGE3_TARBALL" ]]; then
echo "Error: Local Stage 3 tarball '${STAGE3_TARBALL}' not found." >&2
exit 1
fi
if [[ -n "$HOST_MNT" ]]; then
mountpoint -q "$HOST_MNT" 2>/dev/null && { echo "Error: '${HOST_MNT}' already mounted." >&2; exit 1; }
mkdir -p "$HOST_MNT"
else
HOST_MNT="$(mktemp -d "/tmp/mknbd_${TARGET_HOSTNAME}.XXXXXX")"
AUTO_MNT=1
fi
cleanup() {
if [[ "$CLEANUP_NEEDED" -eq 1 ]]; then
umount -R "$HOST_MNT" 2>/dev/null || true
qemu-nbd --disconnect "$NBD_DEV" &>/dev/null || true
fi
[[ "$AUTO_MNT" -eq 1 ]] && rmdir "$HOST_MNT" 2>/dev/null || true
}
trap cleanup EXIT
echo "==> [1/6] Creating metadata-preallocated qcow2 (${IMG_SIZE}) at ${IMG_PATH}..."
modprobe nbd max_part=8
qemu-img create -f qcow2 -o preallocation=metadata "$IMG_PATH" "$IMG_SIZE"
qemu-nbd --connect="$NBD_DEV" --discard=unmap "$IMG_PATH"
CLEANUP_NEEDED=1
sleep 1
echo "==> [2/6] Formatting ${NBD_DEV} as ext4 and mounting at ${HOST_MNT}..."
mkfs.ext4 -F -L "gentoo_${TARGET_HOSTNAME}" "$NBD_DEV"
mount -o noatime,lazytime "$NBD_DEV" "$HOST_MNT"
echo "==> [3/6] Extracting Stage 3 ($(basename "$STAGE3_TARBALL"))..."
tar xpf "$STAGE3_TARBALL" -C "$HOST_MNT" --xattrs-include='.' --numeric-owner
echo "==> [4/6] Preparing Stage 3 environment and bind mounts..."
if [[ -n "$CONFIG_ROOT_DIR" ]]; then
echo "    Applying config_root overlay from ${CONFIG_ROOT_DIR}..."
rsync -a --exclude='etc/portage/make.conf' --exclude='etc/portage/make.profile' --exclude='*.bak'
"${CONFIG_ROOT_DIR}/" "${HOST_MNT}/"
fi
cp -L /etc/resolv.conf "${HOST_MNT}/etc/resolv.conf"
mkdir -p "${HOST_MNT}"/{var/cache/binpkgs,var/cache/distfiles,var/db/repos}
mount --bind -o ro "$REPOS_SRC" "${HOST_MNT}/var/db/repos"
if [[ "$BUILD_MODE" == "binpkg" ]]; then
mount --bind -o ro "$PKGDIR_SRC" "${HOST_MNT}/var/cache/binpkgs"
mount --bind -o ro "$DISTDIR_SRC" "${HOST_MNT}/var/cache/distfiles"
else
mount --bind "$DISTDIR_SRC" "${HOST_MNT}/var/cache/distfiles"
echo 'FEATURES="${FEATURES} -buildpkg -getbinpkg"' >> "${HOST_MNT}/etc/portage/make.conf"
fi
sed -i 's|^PKGDIR=.|PKGDIR="/var/cache/binpkgs"|' "${HOST_MNT}/etc/portage/make.conf"
sed -i 's|^DISTDIR=.|DISTDIR="/var/cache/distfiles"|' "${HOST_MNT}/etc/portage/make.conf"
echo "==> [5/6] Emerging @world inside chroot (${BUILD_MODE} mode)..."
if [[ "$BUILD_MODE" == "binpkg" ]]; then
run_in_chroot "$HOST_MNT" 'env-update && (source /etc/profile || true) && emerge -q --usepkgonly --deep --newuse --update --with-bdeps=n @world'
else
run_in_chroot "$HOST_MNT" 'env-update && (source /etc/profile || true) && emerge -q --deep --newuse --update @world'
fi
if [[ -n "$CUSTOM_MAKE_CONF" ]]; then
echo "==> [6/6] Installing ${CUSTOM_MAKE_CONF}, hostname, fstab, machine-id, and systemd units..."
cp "$CUSTOM_MAKE_CONF" "${HOST_MNT}/etc/portage/make.conf"
else
echo "==> [6/6] Keeping default Stage 3 make.conf; finalizing hostname, fstab, machine-id, and systemd units..."
fi
echo "$TARGET_HOSTNAME" > "${HOST_MNT}/etc/hostname"
echo "${COMMON_NAME}-${VVV} (${BUILD_MODE})" > "${HOST_MNT}/etc/hive-release"
cat < "${HOST_MNT}/etc/fstab"
${GUEST_ROOT_DEV}   /       ext4    defaults,noatime,lazytime   0 1
tmpfs               /tmp    tmpfs   defaults,nosuid,nodev       0 0
EOF
for entry in "${CUSTOM_FSTAB[@]}"; do
echo "$entry" >> "${HOST_MNT}/etc/fstab"
target_dir="$(echo "$entry" | awk '{print $2}')"
[[ -n "$target_dir" && "$target_dir" == /* ]] && mkdir -p "${HOST_MNT}${target_dir}"
done
run_in_chroot "$HOST_MNT" 'systemd-machine-id-setup && systemctl preset-all && systemctl enable systemd-networkd systemd-resolved systemd-homed sshd 2>/dev/null || true'
umount -R "$HOST_MNT"
qemu-nbd --disconnect "$NBD_DEV"
CLEANUP_NEEDED=0
echo "==> Complete: ${IMG_PATH}"
