#!/bin/bash
base="/etc/portage"
dirs=("package.use" "package.env" "package.mask" "package.accept_keywords")

usage() {
    cat <<EOF >&2
Usage:
  $(basename "$0") -t                       List all TMP_* override files
  $(basename "$0") -t -d                    Delete all TMP_* override files and empty dirs
  $(basename "$0") --dedup [type]           Merge duplicate atom entries into single lines per file
  $(basename "$0") <type> <atom> [items...] Remove an atom (or specific flags/envs) from a config

Types:
  use | env | mask | kw | all

Examples:
  $(basename "$0") -t                       # Preview temporary overrides
  $(basename "$0") -t -d                    # Delete all temporary overrides
  $(basename "$0") --dedup                  # Consolidate duplicates across all package.* dirs
  $(basename "$0") --dedup use              # Consolidate duplicates only in package.use
  $(basename "$0") use sys-devel/gcc -go    # Remove only '-go' from sys-devel/gcc
  $(basename "$0") use sys-devel/gcc        # Remove the entire sys-devel/gcc entry/file
EOF
    exit 1
}

# Mode 1: Handle TMP_* cleanup (-t [-d])
[[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && { usage; exit 0; }
if [[ "${1:-}" == "-t" ]]; then
    delete=0
    [[ "$2" == "-d" ]] && delete=1

    found=0
    for d in "${dirs[@]}"; do
        [[ -d "$base/$d" ]] || continue
        while IFS= read -r -d '' f; do
            found=1
            if [[ "$delete" -eq 1 ]]; then
                rm -f "$f" && echo "Removed: $f"
            else
                echo "Found:   $f"
                sed 's/^/  /' "$f"
            fi
        done < <(find "$base/$d" -type f -name "TMP_*" -print0)
    done

    if [[ "$found" -eq 0 ]]; then
        echo "No TMP_* override files found."
        exit 0
    fi

    if [[ "$delete" -eq 1 ]]; then
        for d in "${dirs[@]}"; do
            [[ -d "$base/$d" ]] && find "$base/$d" -mindepth 1 -type d -empty -delete
        done
    else
        echo -e "\nRun '$(basename "$0") -t -d' to delete these temporary files."
    fi
    exit 0
fi

# Mode 2: Consolidate/deduplicate existing files to one merged entry per atom
if [[ "$1" == "--dedup" || "$1" == "-c" ]]; then
    case "${2:-all}" in
        use)  target_dirs=("package.use") ;;
        env)  target_dirs=("package.env") ;;
        mask) target_dirs=("package.mask") ;;
        kw)   target_dirs=("package.accept_keywords") ;;
        all)  target_dirs=("${dirs[@]}") ;;
        *)    usage ;;
    esac

    for d in "${target_dirs[@]}"; do
        [[ -d "$base/$d" ]] || continue
        while IFS= read -r -d '' f; do
            tmp_file="$(mktemp)"
            awk -v dir_type="$d" '
            /^[[:space:]]*$/ || /^[[:space:]]*#/ {
                preserved[++p_count] = $0
                next
            }
            {
                atom = $1
                if (!(atom in seen_atom)) {
                    seen_atom[atom] = 1
                    atom_order[++a_count] = atom
                    item_count[atom] = 0
                }
                for (i = 2; i <= NF; i++) {
                    val = $i
                    if (dir_type == "package.use") {
                        base_val = val
                        sub(/^-/, "", base_val)
                        replaced = 0
                        for (k = 1; k <= item_count[atom]; k++) {
                            existing = atom_items[atom, k]
                            base_ex = existing
                            sub(/^-/, "", base_ex)
                            if (base_ex == base_val) {
                                atom_items[atom, k] = val
                                replaced = 1
                            }
                        }
                        if (!replaced) {
                            atom_items[atom, ++item_count[atom]] = val
                        }
                    } else {
                        exists = 0
                        for (k = 1; k <= item_count[atom]; k++) {
                            if (atom_items[atom, k] == val) exists = 1
                        }
                        if (!exists) {
                            atom_items[atom, ++item_count[atom]] = val
                        }
                    }
                }
            }
            END {
                for (i = 1; i <= p_count; i++) {
                    if (preserved[i] ~ /^[[:space:]]*#/) print preserved[i]
                }
                for (i = 1; i <= a_count; i++) {
                    a = atom_order[i]
                    line = a
                    for (k = 1; k <= item_count[a]; k++) {
                        if (atom_items[a, k] != "") line = line " " atom_items[a, k]
                    }
                    print line
                }
            }' "$f" > "$tmp_file"

            if ! cmp -s "$f" "$tmp_file"; then
                mv "$tmp_file" "$f"
                echo "Consolidated: $f"
            else
                rm -f "$tmp_file"
            fi

            if [[ ! -s "$f" ]] || ! grep -q '[^[:space:]]' "$f"; then
                rm -f "$f"
                echo "Deleted empty file: $f"
            fi
        done < <(find "$base/$d" -type f -print0)

        find "$base/$d" -mindepth 1 -type d -empty -delete 2>/dev/null
    done
    exit 0
fi

# Mode 3: Remove specific atom or specific flags/items
type="$1"
atom="$2"
shift 2 2>/dev/null
items="$*"

[[ -z "$type" || -z "$atom" ]] && usage

case "$type" in
    use)  target_dirs=("package.use") ;;
    env)  target_dirs=("package.env") ;;
    mask) target_dirs=("package.mask") ;;
    kw)   target_dirs=("package.accept_keywords") ;;
    all)  target_dirs=("${dirs[@]}") ;;
    *)    usage ;;
esac

clean="${atom#>=}"
clean="${clean#<=}"
clean="${clean#=}"
clean="${clean#\~}"
clean="${clean#<}"
clean="${clean#>}"
clean="${clean%%::*}"
clean="${clean%%:*}"

cat_dir="${clean%%/*}"
pkgver="${clean#*/}"

ver_regex='-[0-9]+(\.[0-9]+)*([a-z]|[0-9]|_alpha|_beta|_pre|_rc|_p|-r[0-9]+)*$'
if [[ "$pkgver" =~ $ver_regex ]]; then
    pkg_file="$(echo "$pkgver" | sed -E "s/$ver_regex//")"
    if [[ ! "$atom" =~ ^(=|>=|<=|~|<|>) ]]; then
        atom="=$atom"
    fi
else
    pkg_file="$pkgver"
fi

for d in "${target_dirs[@]}"; do
    for prefix in "" "TMP_"; do
        target_file="$base/$d/$cat_dir/${prefix}${pkg_file}"
        [[ -f "$target_file" ]] || continue

        if [[ -z "$items" ]]; then
            tmp_file="$(mktemp)"
            awk -v target_atom="$atom" '
            {
                if ($0 ~ /^#/) {
                    prev_comment = $0
                    next
                }
                if ($1 == target_atom) {
                    prev_comment = ""
                    next
                }
                if (prev_comment != "") {
                    print prev_comment
                    prev_comment = ""
                }
                print $0
            }
            END {
                if (prev_comment != "") print prev_comment
            }' "$target_file" > "$tmp_file" && mv "$tmp_file" "$target_file"
            echo "Removed '$atom' from $target_file"
        else
            tmp_file="$(mktemp)"
            awk -v target_atom="$atom" -v rem_items="$items" '
            BEGIN {
                n = split(rem_items, rem_arr, /[[:space:]]+/)
                for (i = 1; i <= n; i++) if (rem_arr[i] != "") drop[rem_arr[i]] = 1
            }
            {
                if ($1 == target_atom) {
                    line = target_atom
                    kept = 0
                    for (i = 2; i <= NF; i++) {
                        if (!($i in drop)) {
                            line = line " " $i
                            kept++
                        }
                    }
                    if (kept > 0) print line
                } else {
                    print $0
                }
            }' "$target_file" > "$tmp_file" && mv "$tmp_file" "$target_file"
            echo "Removed [$items] from '$atom' in $target_file"
        fi

        if [[ ! -s "$target_file" ]] || ! grep -q '[^[:space:]]' "$target_file"; then
            rm -f "$target_file"
            echo "Deleted empty file: $target_file"
        fi
        rmdir --ignore-fail-on-non-empty "$base/$d/$cat_dir" 2>/dev/null
    done
done
