#!/bin/bash
base="/etc/portage/package.use"
prefix=""
forward=0

# Parse optional -t and -f flags before the atom
while [[ "$1" == -* ]]; do
    case "$1" in
        -t)
            prefix="TMP_"
            shift
            ;;
        -f)
            forward=1
            shift
            ;;
        *)
            echo "Unknown option: $1" >&2
            echo "Usage: $(basename "$0") [-t] [-f] <atom> <useflags...>" >&2
            exit 1
            ;;
    esac
done

atom="$1"
shift
useflags="$*"

if [[ -z "$atom" || -z "$useflags" ]]; then
    echo "Usage: $(basename "$0") [-t] [-f] <atom> <useflags...>" >&2
    exit 1
fi

# Strip any existing version operators (>=, <=, =, ~, <, >) from the front
clean="${atom#>=}"
clean="${clean#<=}"
clean="${clean#=}"
clean="${clean#\~}"
clean="${clean#<}"
clean="${clean#>}"

# Strip ::repo and :slot suffixes from the back
clean="${clean%%::*}"
clean="${clean%%:*}"

# Split category and package-version
dir="${clean%%/*}"
pkgver="${clean#*/}"

# Check if pkgver ends with a Gentoo version suffix
ver_regex='-[0-9]+(\.[0-9]+)*([a-z]|[0-9]|_alpha|_beta|_pre|_rc|_p|-r[0-9]+)*$'
if [[ "$pkgver" =~ $ver_regex ]]; then
    file="$(echo "$pkgver" | sed -E "s/$ver_regex//")"
    if [[ "$forward" -eq 1 ]]; then
        if [[ "$atom" == =* && "$atom" != ==* ]]; then
            atom=">${atom}"
        elif [[ ! "$atom" =~ ^(=|>=|<=|~|<|>) ]]; then
            atom=">=$atom"
        fi
    else
        if [[ ! "$atom" =~ ^(=|>=|<=|~|<|>) ]]; then
            atom="=$atom"
        fi
    fi
else
    file="$pkgver"
    if [[ "$forward" -eq 1 ]]; then
        echo "Warning: -f ignored because '$atom' has no version number." >&2
    fi
fi

target_file="$base/$dir/${prefix}${file}"
mkdir -p "$base/$dir"

# If target file exists and has a line for this exact atom, merge flags cleanly
if [[ -f "$target_file" ]] && grep -q -F -- "$atom " "$target_file"; then
    tmp_file="$(mktemp)"
    awk -v target_atom="$atom" -v new_flags="$useflags" '
    BEGIN {
        n_new = split(new_flags, new_arr, /[[:space:]]+/)
    }
    {
        if ($1 == target_atom) {
            # Start with existing flags on the line
            count = 0
            for (i = 2; i <= NF; i++) {
                flags[++count] = $i
            }
            # Merge each new flag, overriding opposite (-flag vs flag) or duplicates
            for (j = 1; j <= n_new; j++) {
                nf = new_arr[j]
                if (nf == "") continue
                base_nf = nf
                sub(/^-/, "", base_nf)

                replaced = 0
                for (k = 1; k <= count; k++) {
                    base_ef = flags[k]
                    sub(/^-/, "", base_ef)
                    if (base_ef == base_nf) {
                        flags[k] = nf
                        replaced = 1
                    }
                }
                if (!replaced) {
                    flags[++count] = nf
                }
            }
            # Reconstruct the single merged line
            line = target_atom
            for (k = 1; k <= count; k++) {
                if (flags[k] != "") line = line " " flags[k]
            }
            print line
        } else {
            print $0
        }
    }' "$target_file" > "$tmp_file" && mv "$tmp_file" "$target_file"
else
    echo "$atom $useflags" >> "$target_file"
fi
