#!/usr/bin/env bash
set -euo pipefail
base="/etc/portage/package.use"; prefix=""; forward=0; view_mode=0; interactive_mode=0
usage() { echo "Usage: $(basename "$0") [-i|-v] <category/package> | [-t] [-f] <category/package> <useflags...>" >&2; }
while [[ "${1:-}" == -* ]]; do
    case "$1" in
        -i) interactive_mode=1; shift ;;
        -v) view_mode=1; shift ;;
        -t) prefix="TMP_"; shift ;;
        -f) forward=1; shift ;;
        -h|--help) usage; exit 0 ;;
        *) echo "Unknown option: $1" >&2; usage; exit 1 ;;
    esac
done
atom="${1:-}"; shift || true; useflags="$*"
[[ -z "$atom" || "$atom" != */* ]] && { echo "Error: Full category/package atom required." >&2; usage; exit 1; }
[[ "$view_mode" -eq 0 && -z "$useflags" ]] && interactive_mode=1
query_pkg_flags() {
    python3 - "$1" <<'PY'
import re, sys, portage
from pathlib import Path
raw = next(iter(sys.argv[slice(1, None)]))
clean, _, _ = re.sub(r"^[<>~=]+", "", raw).partition("::")
clean, _, _ = clean.partition(":")
vardb, portdb = portage.db[portage.root]["vartree"].dbapi, portage.db[portage.root]["porttree"].dbapi
def sm(db, a):
    try: return db.match(a)
    except portage.exception.InvalidAtom: return []
cpv = clean if vardb.cpv_exists(clean) else None
if not cpv:
    cand = f"={clean}" if portage.catpkgsplit(clean) else clean
    m = sm(vardb, cand) or sm(vardb, clean) or sm(portdb, cand) or sm(portdb, clean)
    cpv = sorted(m)[-1] if m else None
if not cpv: sys.exit(f"Error: Could not resolve '{raw}'.")
cp, inst = portage.cpv_getkey(cpv), vardb.cpv_exists(cpv)
db = vardb if inst else portdb
iuse, act = db.aux_get(cpv, ["IUSE", "USE"])
aset, aflags = (set(act.split()) if inst else set()), sorted({f.lstrip("+-") for f in iuse.split()})
ov, bdir = {}, Path("/etc/portage/package.use")
if bdir.exists():
    for f in ([bdir] if bdir.is_file() else sorted(x for x in bdir.rglob("*") if x.is_file())):
        for ln in f.read_text(encoding="utf-8", errors="ignore").splitlines():
            t = ln.split()
            if len(t) >= 2 and not ln.lstrip().startswith("#"):
                a, _, _ = re.sub(r"^[<>~=]+", "", next(iter(t))).partition("::")
                a, _, _ = a.partition(":")
                try: lcp = portage.dep_getkey(a)
                except portage.exception.InvalidAtom: lcp = portage.cpv_getkey(a)
                if lcp == cp:
                    for x in t[1:]: ov[x.lstrip("-")] = not x.startswith("-")
print(f"META|{cpv}|{cp}|{1 if inst else 0}")
for fl in aflags:
    io = 1 if fl in aset else 0
    print(f"FLAG|{fl}|{io}|{1 if ov.get(fl, bool(io)) else 0}|{1 if fl in ov else 0}")
PY
}
write_single_entry() {
    local t_atom="$1" t_file="$2" new_flags="$3"
    [[ -e "$base" && ! -d "$base" ]] && rm -f "$base"
    [[ -e "$(dirname "$t_file")" && ! -d "$(dirname "$t_file")" ]] && rm -f "$(dirname "$t_file")"
    mkdir -p "$(dirname "$t_file")"; [[ -d "$t_file" ]] && rm -rf "$t_file"
    [[ -z "$new_flags" ]] && { rm -f "$t_file"; rmdir "$(dirname "$t_file")" 2>/dev/null || true; return; }
    awk -v ta="$t_atom" -v nf="$new_flags" 'BEGIN {
        n=split(nf,a,/[[:space:]]+/); c=0
        for(j=1;j<=n;j++){ if(a[j]=="")continue; b=a[j]; sub(/^-/,"",b); r=0
            for(k=1;k<=c;k++){ eb=f[k]; sub(/^-/,"",eb); if(eb==b){f[k]=a[j];r=1} }
            if(!r) f[++c]=a[j] }
        if(c>0){ l=ta; for(k=1;k<=c;k++) l=l" "f[k]; print l }
    }' > "$t_file"
}
if [[ "$view_mode" -eq 1 || "$interactive_mode" -eq 1 ]]; then
    mapfile -t raw_lines < <(query_pkg_flags "$atom")
    resolved_cpv=""; resolved_cp=""; is_inst=0
    declare -a flag_names=() flag_inst=() flag_eff=() flag_ov=()
    for line in "${raw_lines[@]}"; do
        IFS='|' read -r kind f1 f2 f3 f4 <<< "$line"
        if [[ "$kind" == "META" ]]; then resolved_cpv="$f1"; resolved_cp="$f2"; is_inst="$f3"
        elif [[ "$kind" == "FLAG" ]]; then flag_names+=("$f1"); flag_inst+=("$f2"); flag_eff+=("$f3"); flag_ov+=("$f4"); fi
    done
    if [[ "$view_mode" -eq 1 ]]; then
        echo "Package: ${resolved_cpv} ($( [[ "$is_inst" -eq 1 ]] && echo "installed" || echo "not installed" ))"
        for idx in "${!flag_names[@]}"; do
            mark=$( [[ "${flag_eff[$idx]}" -eq 1 ]] && echo "[+]" || echo "[-]" ); note=""
            [[ "$is_inst" -eq 1 ]] && note=$( [[ "${flag_inst[$idx]}" -eq 1 ]] && echo "installed" || echo "off" )
            if [[ "${flag_ov[$idx]}" -eq 1 ]]; then
                ov_txt="package.use"
                [[ "$is_inst" -eq 1 && "${flag_eff[$idx]}" -ne "${flag_inst[$idx]}" ]] && ov_txt=$( [[ "${flag_eff[$idx]}" -eq 1 ]] && echo "pending enable" || echo "pending disable" )
                note="${note:+${note}, }${ov_txt}"
            fi
            printf "  %s %-22s %s\n" "$mark" "${flag_names[$idx]}" "${note:+(${note})}"
        done; exit 0
    fi
    (( ${#flag_names[@]} == 0 )) && { echo "No configurable USE flags for ${resolved_cpv}."; exit 0; }
    target_file="${base}/${resolved_cp%%/*}/${prefix}${resolved_cp#*/}"
    while true; do
        echo -e "\n=== ${resolved_cp} (${resolved_cpv}) ==="
        PS3="Toggle flag # ([s]ave, [r]eset, [q]uit): "
        menu_items=(); for idx in "${!flag_names[@]}"; do menu_items+=("$( [[ "${flag_eff[$idx]}" -eq 1 ]] && echo "[+]" || echo "[-]" ) ${flag_names[$idx]}"); done
        select choice in "${menu_items[@]}"; do
            case "$REPLY" in
                s|S|save)
                    out_flags=(); for idx in "${!flag_names[@]}"; do [[ "${flag_eff[$idx]}" -ne "${flag_inst[$idx]}" ]] && out_flags+=("$( [[ "${flag_eff[$idx]}" -eq 1 ]] && echo "${flag_names[$idx]}" || echo "-${flag_names[$idx]}" )"); done
                    write_single_entry "$resolved_cp" "$target_file" "${out_flags[*]:-}"
                    echo "Saved: ${resolved_cp} ${out_flags[*]:-(reverted)}"; exit 0 ;;
                r|R|reset)
                    for idx in "${!flag_names[@]}"; do flag_eff[$idx]="${flag_inst[$idx]}"; done; break ;;
                q|Q|quit) exit 0 ;;
                *)
                    if [[ "$REPLY" =~ ^[0-9]+$ ]] && (( REPLY >= 1 && REPLY <= ${#flag_names[@]} )); then
                        ai=$((REPLY - 1)); flag_eff[$ai]=$(( 1 - flag_eff[$ai] )); break
                    fi; echo "Invalid choice: $REPLY" ;;
            esac
        done
    done
fi
clean="${atom#>=}"; clean="${clean#<=}"; clean="${clean#=}"; clean="${clean#\~}"; clean="${clean#<}"; clean="${clean#>}"
clean="${clean%%::*}"; clean="${clean%%:*}"; dir="${clean%%/*}"; pkgver="${clean#*/}"
ver_regex='-[0-9]+(\.[0-9]+)*([a-z]|[0-9]|_alpha|_beta|_pre|_rc|_p|-r[0-9]+)*$'
if [[ "$pkgver" =~ $ver_regex ]]; then
    file="$(echo "$pkgver" | sed -E "s/$ver_regex//")"
    target_atom=$( [[ "$forward" -eq 1 ]] && echo ">=$clean" || echo "$dir/$file" )
else
    file="$pkgver"; target_atom="$dir/$file"
fi
write_single_entry "$target_atom" "$base/$dir/${prefix}${file}" "$useflags"
