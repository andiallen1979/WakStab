#!/usr/bin/env bash
set -euo pipefail

base="/etc/portage/package.use"
prefix=""
forward=0

# Parse optional -t and -f flags before the atom
while [[ "${1:-}" == -* ]]; do
    case "$1" in
        -t)
            prefix="TMP_"
            shift
            ;;
        -f)
            forward=1
            shift
            ;;
        *)
            echo "Unknown option: $1" >&2
            echo "Usage: $(basename "$0") [-t] [-f] <atom> <useflags...>" >&2
            exit 1
            ;;
    esac
done

atom="${1:-}"
shift || true
useflags="$*"

if [[ -z "$atom" || -z "$useflags" ]]; then
    echo "Usage: $(basename "$0") [-t] [-f] <atom> <useflags...>" >&2
    exit 1
fi

# Strip any existing version operators (>=, <=, =, ~, <, >) from the front
clean="${atom#>=}"
clean="${clean#<=}"
clean="${clean#=}"
clean="${clean#\~}"
clean="${clean#<}"
clean="${clean#>}"

# Strip ::repo and :slot suffixes from the back

clean="${clean%%::}"
clean="${clean%%:}"

dir="${clean%%/}"
pkgver="${clean#/}"

ver_regex='-[0-9]+(.[0-9]+)([a-z]|[0-9]|_alpha|_beta|_pre|_rc|_p|-r[0-9]+)$'
if [[ "$pkgver" =~ $ver_regex ]]; then
file="$(echo "$pkgver" | sed -E "s/$ver_regex//")"
if [[ "$forward" -eq 1 ]]; then
if [[ "$atom" == =* && "$atom" != ==* ]]; then
target_atom=">${atom}"
elif [[ ! "$atom" =~ ^(=|>=|<=|~|<|>) ]]; then
target_atom=">=$atom"
else
target_atom="$atom"
fi
else
target_atom="$dir/$file"
fi
else
file="$pkgver"
target_atom="$dir/$file"
if [[ "$forward" -eq 1 ]]; then
echo "Warning: -f ignored because '$atom' has no version number." >&2
fi
fi
target_file="$base/$dir/${prefix}${file}"
mkdir -p "$base/$dir"

tmp_file="$(mktemp)"
if [[ -f "$target_file" ]]; then
awk -v target_atom="$target_atom" -v new_flags="$useflags" '
BEGIN {
n_new = split(new_flags, new_arr, /[[:space:]]+/)
count = 0
}
/^[[:space:]]#/ {
print $0
next
}
/^[[:space:]]$/ {
next
}
{
for (i = 2; i <= NF; i++) {
ef = $i
if (ef == "") continue
base_ef = ef
sub(/^-/, "", base_ef)
replaced = 0
for (k = 1; k <= count; k++) {
existing_base = flags[k]
sub(/^-/, "", existing_base)
if (existing_base == base_ef) {
flags[k] = ef
replaced = 1
}
}
if (!replaced) {
flags[++count] = ef
}
}
}
END {
for (j = 1; j <= n_new; j++) {
nf = new_arr[j]
if (nf == "") continue
base_nf = nf
sub(/^-/, "", base_nf)
replaced = 0
for (k = 1; k <= count; k++) {
existing_base = flags[k]
sub(/^-/, "", existing_base)
if (existing_base == base_nf) {
flags[k] = nf
replaced = 1
}
}
if (!replaced) {
flags[++count] = nf
}
}
if (count > 0) {
line = target_atom
for (k = 1; k <= count; k++) {
if (flags[k] != "") line = line " " flags[k]
}
print line
}
}' "$target_file" > "$tmp_file" && mv "$tmp_file" "$target_file"
else
rm -f "$tmp_file"
awk -v target_atom="$target_atom" -v new_flags="$useflags" '
BEGIN {
n_new = split(new_flags, new_arr, /[[:space:]]+/)
count = 0
for (j = 1; j <= n_new; j++) {
nf = new_arr[j]
if (nf == "") continue
base_nf = nf
sub(/^-/, "", base_nf)
replaced = 0
for (k = 1; k <= count; k++) {
existing_base = flags[k]
sub(/^-/, "", existing_base)
if (existing_base == base_nf) {
flags[k] = nf
replaced = 1
}
}
if (!replaced) {
flags[++count] = nf
}
}
if (count > 0) {
line = target_atom
for (k = 1; k <= count; k++) {
if (flags[k] != "") line = line " " flags[k]
}
print line
}
}' > "$target_file"
fi
